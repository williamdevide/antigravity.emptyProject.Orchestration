# =============================================================================
# .env-example
# =============================================================================
# Modelo oficial de variáveis de ambiente para projetos baseados em .ag-template.
# Copie este arquivo para .env e preencha com valores reais.
#
# Regras de segurança:
# - Nunca commite .env no repositório.
# - Nunca use NEXT_PUBLIC_ para secrets, tokens, chaves privadas ou credenciais.
# - Use NEXT_PUBLIC_ apenas para configurações públicas e não sensíveis.
# - Rotacione secrets periodicamente e após qualquer exposição acidental.
# - Em CI/CD, use secrets do provedor; não envie .env para pipelines.
# =============================================================================

# =============================================================================
# APLICAÇÃO
# =============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DESCRIPTION=
NEXT_PUBLIC_APP_VERSION=0.1.0

# =============================================================================
# GITHUB (somente servidor/local, nunca NEXT_PUBLIC_)
# =============================================================================
# Personal Access Token com permissões mínimas necessárias.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_BRANCH=main

# =============================================================================
# FIREBASE (quando aplicável)
# =============================================================================
# Configuração pública do projeto (pode ser NEXT_PUBLIC_)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Credenciais de servidor (NUNCA NEXT_PUBLIC_)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# =============================================================================
# SUPABASE (quando aplicável)
# =============================================================================
# Chave pública (pode ser NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço (NUNCA NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# =============================================================================
# GOOGLE STITCH (quando aplicável)
# =============================================================================
# Chave da API (NUNCA NEXT_PUBLIC_)
GOOGLE_STITCH_API_KEY=
GOOGLE_STITCH_PROJECT_ID=
GOOGLE_STITCH_PROJECT_NAME=
GOOGLE_STITCH_MODE=disabled
# Opções: source-of-truth, reference, disabled
GOOGLE_STITCH_FIDELITY=inspired
# Opções: exact, close, inspired

# =============================================================================
# MCPs (Model Context Protocol)
# =============================================================================
MCP_GOOGLE_STITCH_ENABLED=false
MCP_GITHUB_ENABLED=false
MCP_FIREBASE_ENABLED=false
MCP_SUPABASE_ENABLED=false
MCP_SLACK_ENABLED=false
MCP_NOTION_ENABLED=false
MCP_GMAIL_ENABLED=false
MCP_GOOGLE_DRIVE_ENABLED=false
MCP_GITHUB_MCP_DIRECT=false

# =============================================================================
# BANCO DE DADOS (quando aplicável)
# =============================================================================
DATABASE_URL=
DATABASE_DIRECT_URL=
DATABASE_POOL_SIZE=10
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# =============================================================================
# REDIS (quando aplicável)
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TLS=false

# =============================================================================
# AUTENTICAÇÃO E SESSÃO
# =============================================================================
# JWT
JWT_SECRET=
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=30d

# OAuth (quando aplicável)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# =============================================================================
# EMAIL E NOTIFICAÇÕES
# =============================================================================
# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false

# SendGrid (quando aplicável)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Resend (quando aplicável)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# =============================================================================
# ARMAZENAMENTO DE ARQUIVOS
# =============================================================================
# AWS S3 (quando aplicável)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=

# Cloudinary (quando aplicável)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# UploadThing (quando aplicável)
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# =============================================================================
# MONITORAMENTO E LOGS
# =============================================================================
# Sentry (quando aplicável)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=development

# LogRocket (quando aplicável)
NEXT_PUBLIC_LOGROCKET_APP_ID=

# Datadog (quando aplicável)
DD_API_KEY=
DD_APP_KEY=
DD_SITE=datadoghq.com

# =============================================================================
# ANALYTICS
# =============================================================================
# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GA_DEBUG_MODE=false

# Vercel Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# PostHog (quando aplicável)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# =============================================================================
# FEATURE FLAGS
# =============================================================================
NEXT_PUBLIC_ENABLE_LIGHT_THEME=true
NEXT_PUBLIC_ENABLE_DARK_THEME=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_SENTRY=false
NEXT_PUBLIC_ENABLE_LOGROCKET=false
NEXT_PUBLIC_ENABLE_POSTHOG=false
NEXT_PUBLIC_ENABLE_STITCH=false
NEXT_PUBLIC_ENABLE_AI_FEATURES=false
NEXT_PUBLIC_ENABLE_SCRAPERS=false
NEXT_PUBLIC_ENABLE_SOCIAL_SHARE=true
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true

# =============================================================================
# RATE LIMITING E SEGURANÇA
# =============================================================================
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
CORS_ORIGIN=http://localhost:3000
CSRF_SECRET=
ENCRYPTION_KEY=
ENCRYPTION_IV=

# =============================================================================
# SCRAPER (quando aplicável)
# =============================================================================
SCRAPER_USER_AGENT=
SCRAPER_PROXY_URL=
SCRAPER_TIMEOUT_MS=30000
SCRAPER_RETRY_COUNT=3
SCRAPER_CACHE_TTL_SECONDS=21600

# =============================================================================
# IA E AUTOMAÇÃO (quando aplicável)
# =============================================================================
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-1.5-pro

# =============================================================================
# PAGAMENTOS (quando aplicável)
# =============================================================================
# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=brl

# PayPal (quando aplicável)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Mercado Pago (quando aplicável)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=

# =============================================================================
# MAPAS E GEOLOCALIZAÇÃO (quando aplicável)
# =============================================================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=

# =============================================================================
# CI/CD E DEPLOY
# =============================================================================
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
VERCEL_ENV=preview
GITHUB_ACTIONS_ENV=development

# =============================================================================
# VARIÁVEIS DE BUILD
# =============================================================================
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_BUILD_ID=
CI=false

# =============================================================================
# VARIÁVEIS ESPECÍFICAS DO PROJETO
# =============================================================================
# Adicione aqui variáveis específicas do seu domínio de negócio.
# Exemplo para ComixFlix:
# COMIXFLIX_SCRAPER_PANINI_URL=https://paninibooks.com.br
# COMIXFLIX_SCRAPER_MYTHOS_URL=https://mythoseditora.com.br
# COMIXFLIX_SCRAPER_PIPOCA_URL=https://pipocaenanquim.com.br
# =============================================================================